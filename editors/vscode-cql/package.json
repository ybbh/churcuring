{
  "name": "vscode-cql",
  "displayName": "CQL (Churcuring Query Language)",
  "description": "Syntax highlighting for CQL — TLA+-style declarative query language (tree-sitter powered)",
  "version": "0.1.0",
  "publisher": "churcuring",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cql",
        "extensions": [
          ".cql"
        ],
        "aliases": [
          "CQL",
          "cql"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.24.0"
  }
}
